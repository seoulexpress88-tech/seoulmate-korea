{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    { "source": "/guides/city/:city/", "destination": "/destinations/:city/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
